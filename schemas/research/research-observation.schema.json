{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowed.example/schemas/research/research-observation.schema.json",
  "title": "FlowED Research Observation",
  "description": "Blueprint contract for research data derived under an explicit protocol. Operational telemetry does not become research data automatically.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_id",
    "study_id",
    "protocol_version",
    "unit_of_analysis",
    "purpose",
    "provenance",
    "authorization"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "observation_id": { "type": "string", "minLength": 1 },
    "study_id": { "type": "string", "minLength": 1 },
    "protocol_version": { "type": "string", "minLength": 1 },
    "unit_of_analysis": { "type": "string", "minLength": 1 },
    "purpose": { "const": "research" },
    "variables": {
      "type": "object",
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "source_refs", "transformation_id"],
      "properties": {
        "source_type": { "type": "string", "minLength": 1 },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "transformation_id": { "type": "string", "minLength": 1 },
        "transformation_version": { "type": ["string", "null"] },
        "derived_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorization_id", "allowed_purposes"],
      "properties": {
        "authorization_id": { "type": "string", "minLength": 1 },
        "allowed_purposes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "expires_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "minimization_policy_id": { "type": ["string", "null"] },
    "retention_policy_id": { "type": ["string", "null"] },
    "publication_policy_id": { "type": ["string", "null"] }
  }
}

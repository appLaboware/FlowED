{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowed.example/schemas/data-products/aggregate-metric.schema.json",
  "title": "FlowED Aggregate Data Product Metric",
  "description": "Blueprint contract for aggregated data products. This layer is distinct from both operational telemetry and research observations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "metric_id",
    "metric_name",
    "purpose",
    "aggregation",
    "source_studies",
    "release_policy_id"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "metric_id": { "type": "string", "minLength": 1 },
    "metric_name": { "type": "string", "minLength": 1 },
    "purpose": { "const": "data-product" },
    "description": { "type": ["string", "null"] },
    "value": {},
    "unit": { "type": ["string", "null"] },
    "aggregation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "population_size", "aggregation_id"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "population_size": { "type": "integer", "minimum": 1 },
        "aggregation_id": { "type": "string", "minLength": 1 },
        "aggregation_version": { "type": ["string", "null"] }
      }
    },
    "source_studies": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "privacy_review_id": { "type": ["string", "null"] },
    "release_policy_id": { "type": "string", "minLength": 1 },
    "published_at": { "type": ["string", "null"], "format": "date-time" }
  }
}

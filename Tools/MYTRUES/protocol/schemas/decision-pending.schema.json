{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mytrues.dev/protocol/0.2/schemas/decision-pending.schema.json",
  "title": "MyTrues Pending Human Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "requestId",
    "status",
    "provider",
    "decisionRequestId",
    "statusUrl",
    "casePacket"
  ],
  "properties": {
    "protocol": {
      "const": "mytrues.decision/v1"
    },
    "requestId": {
      "type": "string"
    },
    "status": {
      "const": "awaiting-provider-decision"
    },
    "provider": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "decisionRequestId": {
      "type": "string"
    },
    "statusUrl": {
      "type": "string"
    },
    "casePacket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failureCode",
        "abstractContext",
        "sandboxFixture"
      ],
      "properties": {
        "failureCode": {
          "type": "string"
        },
        "abstractContext": {
          "type": "object",
          "additionalProperties": true
        },
        "sandboxFixture": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
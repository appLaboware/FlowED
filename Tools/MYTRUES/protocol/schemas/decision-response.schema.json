{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mytrues.dev/protocol/0.1/schemas/decision-response.schema.json",
  "title": "MyTrues Decision Response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "requestId",
    "status",
    "decision",
    "selected",
    "guards",
    "notice",
    "meta"
  ],
  "properties": {
    "protocol": {
      "const": "mytrues.decision/v1"
    },
    "requestId": {
      "type": "string"
    },
    "status": {
      "const": "decided"
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "selected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "result"
      ],
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "endpoint"
          ],
          "properties": {
            "endpoint": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "value"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "hostname",
                    "ip"
                  ]
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                },
                "scheme": {
                  "enum": [
                    "http",
                    "https"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "guards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "satisfied"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "satisfied": {
            "type": "boolean"
          }
        }
      }
    },
    "notice": {
      "type": "string"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "policyVersion"
      ],
      "properties": {
        "engine": {
          "type": "string"
        },
        "policyVersion": {
          "type": "string"
        }
      }
    }
  }
}